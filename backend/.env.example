# AgriVision AI Backend Environment Configuration (Production Template)
# Generate a new secure secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate-a-strong-random-secret-key-here-min-50-chars

# Set to False in production
DEBUG=False

# Comma-separated allowed hostnames and domain names
ALLOWED_HOSTS=localhost,127.0.0.1,api.agrivision.in

# Specific allowed origins for CORS (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5500,https://agrivision.in

# Database configuration
DATABASE_URL=sqlite:///db.sqlite3

# AgriVision ML Service Endpoint
ML_API_URL=http://127.0.0.1:5000
